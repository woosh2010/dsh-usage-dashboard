{
  "name": "@deepseek-ai/dsh-client-ui-usage",
  "description": "Usage dashboard for the conversation composer dock: peak/valley pricing with period progress, live DeepSeek balance, cross-session usage history and analysis charts",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/woosh2010/dsh-usage-dashboard.git"
  },
  "homepage": "https://github.com/woosh2010/dsh-usage-dashboard#readme",
  "bugs": {
    "url": "https://github.com/woosh2010/dsh-usage-dashboard/issues"
  },
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "zod": "^4.4.3",
    "@deepseek-ai/dsh-credentials": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-home-paths": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-launch-environment": "^0.1.1-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "license": "MIT"
}
